# Backend-only Bareos API settings. Copy to .env and supply real values.
BAREOS_API_BASE_URL="https://bareos.example.internal/bareos-api"
BAREOS_API_TOKEN_ENDPOINT="/token"
BAREOS_API_USERNAME=""
BAREOS_API_PASSWORD=""
# PEM certificate used to validate the Bareos HTTPS endpoint. Use escaped newlines.
BAREOS_API_TLS_CA_PEM=""

# Optional provisioning: these are PostgreSQL HOST SSH login settings, not database roles.
POSTGRES_HOST=""
POSTGRES_USERNAME=""
POSTGRES_PASSWORD=""
# BACKUPCENTER_DB_* runtime credentials are generated by scripts/bootstrap_database.py.

# Optional VMware inventory; backend only.
VMWARE_VCSERVER=""
VMWARE_VCUSER=""
VMWARE_VCPASS=""
VMWARE_VCTHUMBPRINT=""
# Generated once by bootstrap_admin; never commit actual credentials.
BACKUPCENTER_ADMIN_USERNAME="admin"
BACKUPCENTER_ADMIN_PASSWORD=""

# Keep isolated restore dispatch disabled until test-job approval and server scope setup.
BACKUPCENTER_RESTORE_DISPATCH_ENABLED="0"
BACKUPCENTER_RESTORE_TEST_JOB=""

# All live job mutations remain disabled until operator activation.
BACKUPCENTER_OPERATION_DISPATCH_ENABLED="0"

# Optional explicit Run/Cancel scope. Empty means deny all.
BACKUPCENTER_OPERATION_JOBS="VMware-MTIMRWZTNA01,VMware-MTIMRWPGSQL01,VMware-MTIMRWNTP02,VMware-MTIMRWNTP01,VMware-MTIMRWKF01,VMware-MTIMRWCNTDEV"

# Controlled onboarding is off by default; root-owned UUID approval is also required.
BACKUPCENTER_ONBOARDING_ENABLED="0"
BACKUPCENTER_ONBOARDING_UUIDS=""

# Direct new-VM restore also requires root-scoped gateway approval.
BACKUPCENTER_DIRECT_VM_RESTORE_ENABLED=0
